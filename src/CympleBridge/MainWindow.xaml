<Window x:Class="CympleBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Cymple Bridge"
        Width="900"
        Height="668"
        MinWidth="820"
        MinHeight="600"
        Background="{StaticResource B.Bg0}"
        FontFamily="{StaticResource F.Display}"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="OnLoaded">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource B.Line}" BorderThickness="1">
        <Grid ClipToBounds="True">
            <!--  atmosphere  -->
            <Rectangle Fill="{StaticResource GridBrush}" />
            <Ellipse Width="760"
                     Height="760"
                     Margin="-300,-360,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#265AF2A6" />
                        <GradientStop Offset="1" Color="#005AF2A6" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="640"
                     Height="640"
                     Margin="0,0,-260,-300"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#1A5AD7FF" />
                        <GradientStop Offset="1" Color="#005AD7FF" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <DockPanel>

                <!--  title bar  -->
                <Grid Height="44" DockPanel.Dock="Top">
                    <StackPanel Margin="18,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="11" Height="11" Background="{StaticResource B.Green}" CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" Color="{StaticResource C.Green}" ShadowDepth="0" />
                            </Border.Effect>
                        </Border>
                        <TextBlock Margin="11,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource B.TextDim}"
                                   Text="CYMPLE BRIDGE" />
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource F.Mono}"
                                   FontSize="11"
                                   Foreground="{StaticResource B.TextFaint}"
                                   Text="v1.0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="OnMinimize"
                                Content="—"
                                Style="{StaticResource Chrome}" />
                        <Button Click="OnClose"
                                Content="✕"
                                Style="{StaticResource Chrome}" />
                    </StackPanel>
                </Grid>

                <!--  footer  -->
                <Border Height="34" DockPanel.Dock="Bottom" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0">
                    <Grid Margin="20,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{StaticResource F.Mono}"
                                   FontSize="11"
                                   Foreground="{StaticResource B.TextFaint}"
                                   Text="TARGET 127.0.0.1:23303    FLAG 2 · MOUTH    CHUNK 1400 B" />
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource F.Mono}"
                                   FontSize="11"
                                   Foreground="{StaticResource B.TextFaint}"
                                   Text="BABBLE  →  CYMPLE" />
                    </Grid>
                </Border>

                <!--  content  -->
                <Grid x:Name="ContentRoot" Margin="22,6,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  header  -->
                    <Grid Grid.Row="0" Margin="0,4,0,20">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource F.Mono}"
                                       FontSize="12"
                                       Foreground="{StaticResource B.TextFaint}"
                                       Text="MOUTH TRACKER RELAY" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="40"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource B.Text}"
                                       Text="CYMPLE BRIDGE" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                            <Ellipse x:Name="Led"
                                     Width="12"
                                     Height="12"
                                     VerticalAlignment="Center"
                                     Fill="{Binding StateBrush}">
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="LedGlow"
                                                      BlurRadius="16"
                                                      Color="{StaticResource C.Green}"
                                                      ShadowDepth="0" />
                                </Ellipse.Effect>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PulseStory">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1"
                                                                             To="0.35"
                                                                             Duration="0:0:0.7" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="1"
                                                                             Duration="0:0:0.1" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource F.Mono}"
                                       FontSize="14"
                                       Foreground="{Binding StateBrush}"
                                       Text="{Binding StateText}" />
                        </StackPanel>
                    </Grid>

                    <!--  source  -->
                    <Border Grid.Row="1"
                            Padding="18"
                            Background="{StaticResource B.Panel}"
                            BorderBrush="{StaticResource B.Line}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <Grid>
                                <TextBlock FontFamily="{StaticResource F.Mono}"
                                           FontSize="12"
                                           Foreground="{StaticResource B.TextDim}"
                                           Text="SOURCE — MJPEG STREAM" />
                                <TextBlock HorizontalAlignment="Right"
                                           FontFamily="{StaticResource F.Mono}"
                                           FontSize="11"
                                           Foreground="{StaticResource B.TextFaint}"
                                           Text="wireless tracker" />
                            </Grid>
                            <TextBox Margin="0,10,0,0"
                                     Style="{StaticResource Field}"
                                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <!--  relay + signal  -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ToggleButton IsChecked="{Binding IsOn}" Style="{StaticResource RelaySwitch}" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource F.Mono}"
                                       FontSize="11"
                                       Foreground="{StaticResource B.TextFaint}"
                                       Text="RELAY" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Margin="20,0,0,0"
                                Padding="18,14"
                                Background="{StaticResource B.Panel}"
                                BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource F.Mono}"
                                               FontSize="12"
                                               Foreground="{StaticResource B.TextDim}"
                                               Text="SIGNAL" />
                                    <ProgressBar x:Name="MeterBar"
                                                 Margin="0,12,220,0"
                                                 Maximum="60"
                                                 Style="{StaticResource Meter}"
                                                 Value="{Binding Fps, Mode=OneWay}" />
                                    <Border Height="8"
                                            Margin="0,6,220,0"
                                            Background="{StaticResource Ticks}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource F.Mono}"
                                               FontSize="34"
                                               Foreground="{Binding StateBrush}"
                                               Text="{Binding FpsText}" />
                                    <TextBlock Margin="8,0,0,4"
                                               VerticalAlignment="Bottom"
                                               FontFamily="{StaticResource F.Mono}"
                                               FontSize="12"
                                               Foreground="{StaticResource B.TextFaint}"
                                               Text="FPS" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--  counters  -->
                    <UniformGrid Grid.Row="3" Margin="0,16,0,0" Columns="3" Rows="1">
                        <Border Margin="0,0,8,0"
                                Padding="16,12"
                                Background="{StaticResource B.Panel}"
                                BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource F.Mono}"
                                           FontSize="11"
                                           Foreground="{StaticResource B.TextFaint}"
                                           Text="FRAMES" />
                                <TextBlock Margin="0,4,0,0"
                                           FontFamily="{StaticResource F.Mono}"
                                           FontSize="24"
                                           Foreground="{StaticResource B.Text}"
                                           Text="{Binding FramesText}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="4,0"
                                Padding="16,12"
                                Background="{StaticResource B.Panel}"
                                BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource F.Mono}"
                                           FontSize="11"
                                           Foreground="{StaticResource B.TextFaint}"
                                           Text="PACKETS" />
                                <TextBlock Margin="0,4,0,0"
                                           FontFamily="{StaticResource F.Mono}"
                                           FontSize="24"
                                           Foreground="{StaticResource B.Text}"
                                           Text="{Binding PacketsText}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="8,0,0,0"
                                Padding="16,12"
                                Background="{StaticResource B.Panel}"
                                BorderBrush="{StaticResource B.Line}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource F.Mono}"
                                           FontSize="11"
                                           Foreground="{StaticResource B.TextFaint}"
                                           Text="UPTIME" />
                                <TextBlock Margin="0,4,0,0"
                                           FontFamily="{StaticResource F.Mono}"
                                           FontSize="24"
                                           Foreground="{StaticResource B.Text}"
                                           Text="{Binding UptimeText}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!--  console  -->
                    <Border Grid.Row="4"
                            Margin="0,16,0,0"
                            Padding="18,14"
                            Background="{StaticResource B.Panel}"
                            BorderBrush="{StaticResource B.Line}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <TextBlock FontFamily="{StaticResource F.Mono}"
                                           FontSize="12"
                                           Foreground="{StaticResource B.TextDim}"
                                           Text="CONSOLE" />
                                <Button Click="OnClearLogs"
                                        Content="CLEAR"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource Ghost}" />
                            </Grid>
                            <ScrollViewer x:Name="ConsoleScroll"
                                          Margin="0,12,0,0"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="{StaticResource F.Mono}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource B.TextFaint}"
                                                           Text="{Binding Time}" />
                                                <TextBlock Grid.Column="1"
                                                           Width="62"
                                                           Margin="12,0,0,0"
                                                           FontFamily="{StaticResource F.Mono}"
                                                           FontSize="12"
                                                           Foreground="{Binding LevelBrush}"
                                                           Text="{Binding Level}" />
                                                <TextBlock Grid.Column="2"
                                                           FontFamily="{StaticResource F.Mono}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource B.TextDim}"
                                                           Text="{Binding Message}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                </Grid>
            </DockPanel>

            <Rectangle Fill="{StaticResource ScanBrush}" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
