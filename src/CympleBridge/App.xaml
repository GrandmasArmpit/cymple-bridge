<Application x:Class="CympleBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!--  Palette: industrial rack panel, phosphor readouts  -->
        <Color x:Key="C.Bg0">#FF06080A</Color>
        <Color x:Key="C.Bg1">#FF0B0F12</Color>
        <Color x:Key="C.Panel">#FF11161A</Color>
        <Color x:Key="C.PanelHi">#FF171E24</Color>
        <Color x:Key="C.Line">#FF202A31</Color>
        <Color x:Key="C.LineHi">#FF2E3A44</Color>
        <Color x:Key="C.Text">#FFE9F1F5</Color>
        <Color x:Key="C.TextDim">#FF8494A0</Color>
        <Color x:Key="C.TextFaint">#FF4E5B65</Color>
        <Color x:Key="C.Green">#FF5AF2A6</Color>
        <Color x:Key="C.GreenDim">#FF1B6E4C</Color>
        <Color x:Key="C.Amber">#FFFFB454</Color>
        <Color x:Key="C.Red">#FFFF6B6B</Color>
        <Color x:Key="C.Cyan">#FF5AD7FF</Color>

        <SolidColorBrush x:Key="B.Bg0" Color="{StaticResource C.Bg0}" />
        <SolidColorBrush x:Key="B.Bg1" Color="{StaticResource C.Bg1}" />
        <SolidColorBrush x:Key="B.Panel" Color="{StaticResource C.Panel}" />
        <SolidColorBrush x:Key="B.PanelHi" Color="{StaticResource C.PanelHi}" />
        <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}" />
        <SolidColorBrush x:Key="B.LineHi" Color="{StaticResource C.LineHi}" />
        <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
        <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}" />
        <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}" />
        <SolidColorBrush x:Key="B.Green" Color="{StaticResource C.Green}" />
        <SolidColorBrush x:Key="B.GreenDim" Color="{StaticResource C.GreenDim}" />
        <SolidColorBrush x:Key="B.Amber" Color="{StaticResource C.Amber}" />
        <SolidColorBrush x:Key="B.Red" Color="{StaticResource C.Red}" />
        <SolidColorBrush x:Key="B.Cyan" Color="{StaticResource C.Cyan}" />

        <FontFamily x:Key="F.Display">Bahnschrift, Segoe UI</FontFamily>
        <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

        <!--  Faint engineering grid  -->
        <DrawingBrush x:Key="GridBrush" TileMode="Tile" Viewport="0,0,34,34" ViewportUnits="Absolute" Opacity="0.5">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF111820" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="34,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,34" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="ScanBrush" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Opacity="0.35">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#12000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="Ticks" TileMode="Tile" Viewport="0,0,10,8" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF1C242B" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,0" EndPoint="0,8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource B.Green}" />
            <Setter Property="SelectionBrush" Value="{StaticResource B.GreenDim}" />
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="48" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Shell"
                                Background="{StaticResource B.Bg0}"
                                BorderBrush="{StaticResource B.LineHi}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid>
                                <Border x:Name="Glow" Background="#00000000" CornerRadius="3" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="14,0"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource B.Green}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Chrome / ghost buttons  -->
        <Style x:Key="Chrome" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource B.PanelHi}" />
                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
            <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{StaticResource B.PanelHi}"
                                BorderBrush="{StaticResource B.LineHi}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource B.Cyan}" />
                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  The relay switch  -->
        <Style x:Key="RelaySwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="168" Height="56">
                            <Border x:Name="Track"
                                    Background="{StaticResource B.Bg0}"
                                    BorderBrush="{StaticResource B.LineHi}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                            <TextBlock x:Name="OffLabel"
                                       Margin="14,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource F.Mono}"
                                       FontSize="13"
                                       Foreground="{StaticResource B.TextDim}"
                                       Text="OFF" />
                            <TextBlock x:Name="OnLabel"
                                       Margin="0,0,14,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource F.Mono}"
                                       FontSize="13"
                                       Foreground="{StaticResource B.TextFaint}"
                                       Text="ON" />
                            <Border x:Name="Knob"
                                    Width="74"
                                    Height="46"
                                    Margin="5"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource B.PanelHi}"
                                    BorderBrush="{StaticResource B.LineHi}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    RenderTransformOrigin="0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Border.RenderTransform>
                                <TextBlock x:Name="KnobText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource F.Display}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource B.TextDim}"
                                           Text="OFF" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="Background" Value="#FF0F3A29" />
                                <Setter TargetName="Knob" Property="BorderBrush" Value="{StaticResource B.Green}" />
                                <Setter TargetName="Knob" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18"
                                                          Color="{StaticResource C.Green}"
                                                          Opacity="0.55"
                                                          ShadowDepth="0" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="KnobText" Property="Foreground" Value="{StaticResource B.Green}" />
                                <Setter TargetName="KnobText" Property="Text" Value="ON" />
                                <Setter TargetName="OnLabel" Property="Foreground" Value="{StaticResource B.Green}" />
                                <Setter TargetName="OffLabel" Property="Foreground" Value="{StaticResource B.TextFaint}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="84"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0"
                                                             Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Segmented signal meter  -->
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource B.Green}" />
            <Setter Property="Background" Value="{StaticResource B.Bg0}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource B.Line}"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                            <Rectangle x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

    </Application.Resources>
</Application>
